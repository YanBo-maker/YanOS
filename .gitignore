*.bin
*.sig
*.hex
*.jsonl
*.dump
*.map

# Credentials and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating-system files
.vs/
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
